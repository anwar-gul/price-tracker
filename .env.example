# Copy to .env and adjust. All PRICETRACKER_* vars are optional.

# --- storage ---
# SQLite (default) or Postgres. In Docker compose this is overridden to the pg service.
PRICETRACKER_DATABASE_URL=sqlite:///data/prices.db
# PRICETRACKER_DATABASE_URL=postgresql+psycopg://pricetracker:change-me@localhost:5432/pricetracker

# --- alerting ---
# Slack incoming webhook or any JSON webhook (auto-detects slack.com URLs)
# PRICETRACKER_WEBHOOK_URL=https://hooks.slack.com/services/T000/B000/XXXX
PRICETRACKER_ALERT_COOLDOWN_HOURS=24
PRICETRACKER_ALERT_ON_ZERO_ITEMS=true
# Failed deliveries are retried with exponential backoff, then marked dead
PRICETRACKER_ALERT_MAX_ATTEMPTS=5
PRICETRACKER_ALERT_RETRY_BASE_SECONDS=60

# Email alerts (optional, legacy var names work too)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=alerts@example.com
# SMTP_PASS=app-password
# ALERT_FROM=pricetracker@example.com
# ALERT_TO=ops@example.com

# --- crawl politeness ---
PRICETRACKER_DOWNLOAD_DELAY=0.5
PRICETRACKER_RETRY_TIMES=3
PRICETRACKER_USER_AGENT=pricetracker/0.2 (contact: you@example.com)

# --- proxy / remote browser (optional) ---
# PRICETRACKER_PROXY_URL=http://user:pass@proxy.example.com:8080
# PRICETRACKER_PLAYWRIGHT_CONNECT_URL=ws://browserless:3000/?token=...

# --- ops ---
PRICETRACKER_LOG_FORMAT=console
PRICETRACKER_METRICS_PORT=0
# watch runs retention prune automatically when due
PRICETRACKER_PRUNE_KEEP_DAYS=90
PRICETRACKER_PRUNE_EVERY_HOURS=24
# Multi-replica HA: watch leaders via a database lease (0 = single instance, file lock only)
PRICETRACKER_LEASE_SECONDS=0
# Optional stable replica name for logs/status (defaults to hostname:pid)
# PRICETRACKER_INSTANCE_ID=tracker-1

# --- remote tables (optional): pricetracker push / watch --push ---
# Airtable: personal access token with data.records:write + base id
# PRICETRACKER_AIRTABLE_TOKEN=patXXXXXXXXXXXXXX
# PRICETRACKER_AIRTABLE_BASE=appXXXXXXXXXXXXXX
# PRICETRACKER_AIRTABLE_TABLE=Catalog
# Google Sheets: service-account JSON (path or JSON text) + spreadsheet name/key
# (share the spreadsheet with the service account email; needs: pip install gspread)
# PRICETRACKER_GSHEETS_CREDENTIALS=/path/to/service-account.json
# PRICETRACKER_GSHEETS_SPREADSHEET=Price tracker
# PRICETRACKER_GSHEETS_WORKSHEET=Catalog
